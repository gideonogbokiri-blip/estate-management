    "bootstrap:platform-super-admin": "node dist/src/cli/bootstrap-platform-super-admin.js",
    "seed:demo": "node dist/src/cli/seed-local-demo.js",
    "seed:gate-demo": "node dist/src/cli/seed-gate-demo.js",
    "seed:walkthrough-accounts": "node dist/src/cli/seed-walkthrough-accounts.js",
    "seed:landlord-demo": "node dist/src/cli/seed-landlord-demo.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@vercel/blob": "^2.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }

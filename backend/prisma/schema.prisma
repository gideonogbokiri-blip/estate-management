  id                    String   @id @default(uuid()) @db.Uuid
  estateId              String   @map("estate_id") @db.Uuid
  gateId                String   @map("gate_id") @db.Uuid
  deviceHash            String   @map("device_hash") @db.VarChar(64)
  credentialFingerprint String   @map("credential_fingerprint") @db.VarChar(64)
  windowStartedAt       DateTime @map("window_started_at") @db.Timestamptz(3)
  attempts              Int      @default(1)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([estateId, gateId, deviceHash, credentialFingerprint, windowStartedAt])
  @@index([updatedAt])
  @@map("estate_gate_verification_attempts")
}

model EstateGateManualAdmissionIdempotency {
  id               String    @id @default(uuid()) @db.Uuid
  actorUserId      String    @map("actor_user_id") @db.Uuid
  estateId         String    @map("estate_id") @db.Uuid
  gateId           String    @map("gate_id") @db.Uuid
  idempotencyKeyHash String  @map("idempotency_key_hash") @db.VarChar(64)
  payloadHash      String    @map("payload_hash") @db.VarChar(64)
  state            String    @db.VarChar(20)
  result           Json?
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorUserId, estateId, gateId, idempotencyKeyHash])
  @@index([expiresAt])
  @@map("estate_gate_manual_admission_idempotency")
}

model EstateSecurityContact {
  id          String   @id @default(uuid()) @db.Uuid
  estateId    String   @map("estate_id") @db.Uuid
  label       String   @db.VarChar(80)
  displayName String   @map("display_name") @db.VarChar(120)
  phoneDisplay String  @map("phone_display") @db.VarChar(50)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([estateId, label])
  @@index([estateId, active])
  @@map("estate_security_contacts")
}

model EstateAccountAdjustment {
  id                  String   @id @default(uuid()) @db.Uuid
  estateId            String   @map("estate_id") @db.Uuid
  accountUserId       String   @map("account_user_id") @db.Uuid
  amount              Decimal  @db.Decimal(14, 2)
  currency            String   @db.VarChar(8)
  direction           String   @db.VarChar(6)
  reason              String   @db.VarChar(500)
  createdByUserId     String   @map("created_by_user_id") @db.Uuid
  idempotencyKeyHash  String   @map("idempotency_key_hash") @db.VarChar(64)
  payloadHash         String   @map("payload_hash") @db.VarChar(64)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([createdByUserId, estateId, accountUserId, idempotencyKeyHash])
  @@index([estateId, accountUserId, createdAt])
  @@index([estateId, createdAt])
  @@map("estate_account_adjustments")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  scope       String   @db.VarChar(40)
  estateId    String?  @map("estate_id") @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String   @map("target_id") @db.VarChar(100)
  outcome     String   @db.VarChar(40)
  reason      String?  @db.VarChar(2000)
  metadata    Json?
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([scope, estateId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
}

enum ApplicationDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  MORE_INFORMATION_REQUIRED
}

enum EstateStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EstateExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  PARTIALLY_PAID
  PAID
}

enum EstateBudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

enum EstateNotificationType {
  EXPENSE
  INCIDENT
}

enum EstateMembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PropertyStatus {
  ACTIVE
  UNDER_DEVELOPMENT
  RESERVED
  UNDER_MAINTENANCE
  INACTIVE
  ARCHIVED
}

enum EstateRole {
  ESTATE_ADMINISTRATOR
  ESTATE_MANAGER
  FINANCE_MANAGER
  SECURITY_OFFICER
  RESIDENT
  LANDLORD
}

model User {
  id                    String                      @id @default(uuid()) @db.Uuid
  emailNormalized       String                      @unique @map("email_normalized") @db.VarChar(254)
  displayName           String                      @map("display_name") @db.VarChar(200)
  phone                 String?                     @db.VarChar(50)
  passwordHash          String                      @map("password_hash") @db.VarChar(255)
  status                AccountStatus               @default(ACTIVE)
  emailVerifiedAt       DateTime?                   @map("email_verified_at") @db.Timestamptz(3)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  applications          EstateApplication[]         @relation("ApplicationApplicant")
  assignedApplications  EstateApplication[]         @relation("ApplicationReviewer")
  approvedApplications  EstateApplication[]         @relation("ApplicationApprover")
  initialAdminFor       EstateApplication[]         @relation("ApplicationInitialAdmin")
  sessions              UserSession[]
  platformGrants        PlatformRoleGrant[]
  estateMemberships     EstateMembership[]
  createdProperties     EstateProperty[]            @relation("PropertyCreator")
  updatedProperties     EstateProperty[]            @relation("PropertyUpdater")
  createdStructureNodes EstateStructureNode[]       @relation("StructureCreator")
  updatedStructureNodes EstateStructureNode[]       @relation("StructureUpdater")
  residentJoinRequests  EstateResidentJoinRequest[] @relation("JoinRequestApplicant")
  reviewedJoinRequests  EstateResidentJoinRequest[] @relation("JoinRequestReviewer")
  occupancies           PropertyOccupancy[]         @relation("OccupancyResident")
  createdOccupancies    PropertyOccupancy[]         @relation("OccupancyCreator")
  endedOccupancies      PropertyOccupancy[]         @relation("OccupancyEnder")
  ownershipInterests    EstateOwnershipInterest[]   @relation("PropertyOwner")
  createdOwnerships     EstateOwnershipInterest[]   @relation("OwnershipCreator")
  reviewedOwnerships    EstateOwnershipInterest[]   @relation("OwnershipReviewer")
  tenantTenancies       EstateTenancy[]             @relation("TenancyTenant")
  payeeTenancies        EstateTenancy[]             @relation("TenancyPayee")
  createdTenancies      EstateTenancy[]             @relation("TenancyCreator")
  approvedTenancies     EstateTenancy[]             @relation("TenancyApprover")
  terminatedTenancies   EstateTenancy[]             @relation("TenancyTerminator")
  auditEvents           AuditEvent[]                @relation("AuditActor")

  maintenanceRequests        EstateMaintenanceRequest[]     @relation("MaintenanceRequester")
  assignedMaintenance        EstateMaintenanceRequest[]     @relation("MaintenanceAssignee")
  maintenanceUpdates         EstateMaintenanceUpdate[]      @relation("MaintenanceUpdateAuthor")
  maintenanceHistory         EstateMaintenanceHistory[]     @relation("MaintenanceHistoryActor")
  maintenanceIdempotency     EstateMaintenanceIdempotency[]
  visitorPasses              EstateVisitorPass[]            @relation("VisitorPassHost")
  visitorPassIdempotency     EstateVisitorPassIdempotency[]
  gateAssignments            EstateGateAssignment[]         @relation("GateAssignee")
  createdGateAssignments     EstateGateAssignment[]         @relation("GateAssignmentCreator")
  gateVisitsCheckedIn        EstateVisitorVisit[]           @relation("GateVisitCheckInActor")
  gateVisitsCheckedOut       EstateVisitorVisit[]           @relation("GateVisitCheckOutActor")
  gateCheckInAttempts        EstateGateCheckInIdempotency[]
  createdChargeDefinitions   EstateChargeDefinition[]       @relation("EstateChargeCreator")
  createdChargeVersions      EstateChargeVersion[]          @relation("EstateChargeVersionCreator")
  activatedChargeVersions    EstateChargeVersion[]          @relation("EstateChargeVersionActivator")
  invoiceDraftsPaid          EstateInvoiceDraft[]           @relation("EstateInvoicePayer")
  invoiceDraftsCreated       EstateInvoiceDraft[]           @relation("EstateInvoiceCreator")
  verifiedInvoiceSettlements EstateInvoiceSettlement[]      @relation("InvoiceSettlementVerifier")
  createdSettlementPolicies  EstateSettlementPolicy[]       @relation("EstateSettlementPolicyCreator")
  createdEstateAnnouncements EstateAnnouncement[]           @relation("EstateAnnouncementCreator")
  announcementReads          EstateAnnouncementRead[]       @relation("EstateAnnouncementReader")
  facilityBookings           EstateFacilityBooking[]        @relation("FacilityBookingRequester")
  reviewedFacilityBookings   EstateFacilityBooking[]        @relation("FacilityBookingReviewer")
  facilityBookingHistory     EstateFacilityBookingHistory[] @relation("FacilityBookingHistoryActor")
  createdFacilities          EstateFacility[]               @relation("EstateFacilityCreator")
  reportedIncidents          EstateSecurityIncident[]       @relation("IncidentReporter")
  reviewedIncidents           EstateSecurityIncident[]       @relation("IncidentReviewer")
  securityIncidentHistory     EstateSecurityIncidentHistory[] @relation("IncidentHistoryActor")
  uploadedIncidentEvidence   EstateSecurityIncidentEvidence[] @relation("IncidentEvidenceUploader")
  createdExpenseCategories  EstateExpenseCategory[]         @relation("ExpenseCategoryCreator")
  createdExpensePayees      EstateExpensePayee[]             @relation("ExpensePayeeCreator")
  verifiedExpensePayees     EstateExpensePayee[]             @relation("ExpensePayeeVerifier")
  requestedExpenses         EstateExpenseRequest[]           @relation("ExpenseRequester")
  decidedExpenses           EstateExpenseDecision[]          @relation("ExpenseDecisionActor")
  updatedExpensePolicies    EstateExpensePolicy[]             @relation("ExpensePolicyUpdater")
  createdEstateBudgets      EstateBudget[]                    @relation("EstateBudgetCreator")
  approvedEstateBudgets     EstateBudget[]                    @relation("EstateBudgetApprover")
  estateBudgetDecisions     EstateBudgetDecision[]            @relation("EstateBudgetDecisionActor")
  verifiedExpenseSettlements EstateExpenseSettlement[]        @relation("ExpenseSettlementVerifier")
  estateNotifications       EstateNotification[]              @relation("EstateNotificationRecipient")
  createdStaffInvitations     EstateStaffInvitation[]          @relation("StaffInvitationCreator")
  acceptedStaffInvitations    EstateStaffInvitation[]          @relation("StaffInvitationAcceptor")

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedFromId    String?   @map("rotated_from_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt, expiresAt])
  @@map("user_sessions")
}

model PlatformRoleGrant {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleKey     String   @map("role_key") @db.VarChar(80)
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, roleKey])
  @@index([roleKey, userId])
  @@map("platform_role_grants")
}

model EstateApplication {
  id                     String                      @id @default(uuid()) @db.Uuid
  applicationCode        String                      @unique @map("application_code") @db.VarChar(40)
  applicantUserId        String                      @map("applicant_user_id") @db.Uuid
  proposedName           String                      @default("") @map("proposed_name") @db.VarChar(200)
  estateType             String                      @default("") @map("estate_type") @db.VarChar(80)
  address                String                      @default("") @db.VarChar(300)
  state                  String                      @default("") @db.VarChar(100)
  lga                    String                      @default("") @db.VarChar(100)
  latitude               Decimal?                    @db.Decimal(9, 6)
  longitude              Decimal?                    @db.Decimal(9, 6)
  applicantRelationship  String                      @default("") @map("applicant_relationship") @db.VarChar(100)
  applicantContactName   String                      @default("") @map("applicant_contact_name") @db.VarChar(200)
  applicantContactEmail  String                      @default("") @map("applicant_contact_email") @db.VarChar(254)
  applicantContactPhone  String                      @default("") @map("applicant_contact_phone") @db.VarChar(50)
  managementEntityName   String                      @default("") @map("management_entity_name") @db.VarChar(200)
  registrationNumber     String?                     @map("registration_number") @db.VarChar(100)
  homeCount              Int?                        @map("home_count")
  phaseCount             Int?                        @map("phase_count")
  structureSummary       String?                     @map("structure_summary") @db.VarChar(500)
  status                 ApplicationStatus           @default(DRAFT)
  submittedAt            DateTime?                   @map("submitted_at") @db.Timestamptz(3)
  assignedReviewerUserId String?                     @map("assigned_reviewer_user_id") @db.Uuid
  decisionReason         String?                     @map("decision_reason") @db.VarChar(2000)
  decidedByUserId        String?                     @map("decided_by_user_id") @db.Uuid
  decidedAt              DateTime?                   @map("decided_at") @db.Timestamptz(3)
  initialAdministratorId String?                     @map("initial_administrator_id") @db.Uuid
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  applicant              User                        @relation("ApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  assignedReviewer       User?                       @relation("ApplicationReviewer", fields: [assignedReviewerUserId], references: [id], onDelete: Restrict)
  decidedBy              User?                       @relation("ApplicationApprover", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  initialAdministrator   User?                       @relation("ApplicationInitialAdmin", fields: [initialAdministratorId], references: [id], onDelete: Restrict)
  documents              EstateApplicationDocument[]
  approvedEstate         Estate?

  @@index([applicantUserId, createdAt])
  @@index([status, submittedAt])
  @@index([assignedReviewerUserId, status, submittedAt])
  @@map("estate_applications")
}

model EstateApplicationDocument {
  id                 String                    @id @default(uuid()) @db.Uuid
  applicationId      String                    @map("application_id") @db.Uuid
  category           String                    @db.VarChar(80)
  displayName        String                    @map("display_name") @db.VarChar(160)
  objectKey          String                    @map("object_key") @db.VarChar(500)
  contentType        String                    @map("content_type") @db.VarChar(120)
  byteSize           BigInt                    @map("byte_size")
  checksum           String?                   @db.VarChar(128)
  status             ApplicationDocumentStatus @default(PENDING)
  uploadedAt         DateTime                  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  reviewedAt         DateTime?                 @map("reviewed_at") @db.Timestamptz(3)
  reviewNote         String?                   @map("review_note") @db.VarChar(1000)
  idempotencyKeyHash String?                   @map("idempotency_key_hash") @db.VarChar(64)
  payloadHash        String?                   @map("payload_hash") @db.VarChar(64)
  application        EstateApplication         @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([applicationId, idempotencyKeyHash])
  @@index([applicationId, status])
  @@map("estate_application_documents")
}

model Estate {
  id                      String                          @id @default(uuid()) @db.Uuid
  estateCode              String                          @unique @map("estate_code") @db.VarChar(40)
  approvedApplicationId   String                          @unique @map("approved_application_id") @db.Uuid
  name                    String                          @db.VarChar(200)
  estateType              String                          @map("estate_type") @db.VarChar(80)
  address                 String                          @db.VarChar(300)
  state                   String                          @db.VarChar(100)
  lga                     String                          @db.VarChar(100)
  status                  EstateStatus                    @default(ACTIVE)
  activatedAt             DateTime                        @map("activated_at") @db.Timestamptz(3)
  createdAt               DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  approvedApplication     EstateApplication               @relation(fields: [approvedApplicationId], references: [id], onDelete: Restrict)
  memberships             EstateMembership[]
  properties              EstateProperty[]
  structureNodes          EstateStructureNode[]
  residentJoinRequests    EstateResidentJoinRequest[]
  occupancies             PropertyOccupancy[]
  ownershipInterests      EstateOwnershipInterest[]
  tenancies               EstateTenancy[]
  maintenanceNoticeOutbox EstateMaintenanceNoticeOutbox[]

  maintenanceRequests     EstateMaintenanceRequest[]
  visitorPasses           EstateVisitorPass[]
  visitorPassIdempotency  EstateVisitorPassIdempotency[]
  visitorPassNoticeOutbox EstateVisitorPassNoticeOutbox[]
  gates                   EstateGate[]
  gateAssignments         EstateGateAssignment[]
  visitorVisits           EstateVisitorVisit[]
  accessEvents            EstateAccessEvent[]
  gateCheckInIdempotency  EstateGateCheckInIdempotency[]

  chargeDefinitions  EstateChargeDefinition[]
  invoiceDrafts      EstateInvoiceDraft[]
  settlementPolicies EstateSettlementPolicy[]
  invoiceSettlements EstateInvoiceSettlement[]
  announcements      EstateAnnouncement[]
  facilities         EstateFacility[]
  facilityBookings   EstateFacilityBooking[]
  securityIncidents  EstateSecurityIncident[]
  staffInvitations   EstateStaffInvitation[]
  expensePolicy      EstateExpensePolicy?
  expenseCategories  EstateExpenseCategory[]
  expensePayees      EstateExpensePayee[]
  expenseRequests    EstateExpenseRequest[]
  budgets            EstateBudget[]
  notifications      EstateNotification[]

  @@map("estates")
}

model EstateMembership {
  id        String                 @id @default(uuid()) @db.Uuid
  estateId  String                 @map("estate_id") @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  role      EstateRole
  status    EstateMembershipStatus @default(ACTIVE)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  estate    Estate                 @relation(fields: [estateId], references: [id], onDelete: Restrict)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([estateId, userId, role])
  @@index([userId, status])
  @@index([estateId, status])
  @@map("estate_memberships")
}

model EstateProperty {
  id                   String                      @id @default(uuid()) @db.Uuid
  estateId             String                      @map("estate_id") @db.Uuid
  code                 String                      @db.VarChar(80)
  propertyType         String                      @map("property_type") @db.VarChar(80)
  status               PropertyStatus              @default(ACTIVE)
  unitNumber           String?                     @map("unit_number") @db.VarChar(80)
  address              String?                     @db.VarChar(240)
  description          String?                     @db.VarChar(700)
  latitude             Decimal?                    @db.Decimal(9, 6)
  longitude            Decimal?                    @db.Decimal(9, 6)
  archivedAt           DateTime?                   @map("archived_at") @db.Timestamptz(3)
  createdByUserId      String                      @map("created_by_user_id") @db.Uuid
  updatedByUserId      String?                     @map("updated_by_user_id") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  estate               Estate                      @relation(fields: [estateId], references: [id], onDelete: Restrict)
  structureLinks       EstatePropertyStructure[]
  residentJoinRequests EstateResidentJoinRequest[]
  occupancies          PropertyOccupancy[]
  ownershipInterests   EstateOwnershipInterest[]
  tenancies            EstateTenancy[]
  createdBy            User                        @relation("PropertyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy            User?                       @relation("PropertyUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  maintenanceRequests  EstateMaintenanceRequest[]
  visitorPasses        EstateVisitorPass[]
  visitorVisits        EstateVisitorVisit[]
  chargeVersions       EstateChargeVersion[]
  invoiceDrafts        EstateInvoiceDraft[]
  facilityBookings     EstateFacilityBooking[]

  @@unique([estateId, code])
  @@unique([estateId, id])
  @@index([estateId, status, createdAt])
  @@map("estate_properties")
}

enum StructureNodeType {
  ZONE
  STREET
  BUILDING
  FLOOR
}

enum StructureNodeStatus {
  ACTIVE
  ARCHIVED
}

enum ResidentJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyOccupancyRelationship {
  OWNER
  TENANT
  HOUSEHOLD_MEMBER
  AUTHORIZED_OCCUPANT
}

enum PropertyOccupancyStatus {
  ACTIVE
  ENDED
}

enum OwnershipInterestStatus {
  ACTIVE
  ENDED
}

enum OwnershipVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TenancyStatus {
  PENDING_APPROVAL
  ACTIVE
  ENDED
  TERMINATED
  CANCELLED
}

enum MaintenanceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  AWAITING_PARTS
  RESOLVED
  CLOSED
  REJECTED
  REOPENED
}

enum MaintenanceUpdateVisibility {
  RESIDENT_VISIBLE
  INTERNAL
}

enum RentFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum EstateChargeRecurrence {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum EstateChargeScope {
  ESTATE
  PROPERTY
  PROPERTY_TYPE
}

enum EstateChargeVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum EstateInvoiceDraftStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum EstateSettlementPolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum EstateAnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum EstateAnnouncementPriority {
  NORMAL
  EMERGENCY
}

enum EstateFacilityApprovalMode {
  MANUAL
  AUTOMATIC
}

enum EstateFacilityBookingStatus {
  PENDING_REVIEW
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

model EstateStructureNode {
  id           String                    @id @default(uuid()) @db.Uuid
  estateId     String                    @map("estate_id") @db.Uuid
  type         StructureNodeType
  name         String                    @db.VarChar(120)
  code         String?                   @db.VarChar(60)
  buildingType String?                   @map("building_type") @db.VarChar(80)
  floorCount   Int?                      @map("floor_count")
  sortOrder    Int                       @default(0) @map("sort_order")
  status       StructureNodeStatus       @default(ACTIVE)
  createdById  String                    @map("created_by_id") @db.Uuid
  updatedById  String?                   @map("updated_by_id") @db.Uuid
  archivedAt   DateTime?                 @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  estate       Estate                    @relation(fields: [estateId], references: [id], onDelete: Restrict)
  createdBy    User                      @relation("StructureCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?                     @relation("StructureUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  parents      EstateStructureParent[]   @relation("StructureChild")
  children     EstateStructureParent[]   @relation("StructureParent")
  properties   EstatePropertyStructure[]

  @@unique([estateId, type, code])
  @@index([estateId, type, status, sortOrder])
  @@map("estate_structure_nodes")
}

model EstateStructureParent {
  childId  String              @map("child_id") @db.Uuid
  parentId String              @map("parent_id") @db.Uuid
  child    EstateStructureNode @relation("StructureChild", fields: [childId], references: [id], onDelete: Restrict)
  parent   EstateStructureNode @relation("StructureParent", fields: [parentId], references: [id], onDelete: Restrict)

  @@id([childId, parentId])
  @@index([parentId])
  @@map("estate_structure_parents")
}

model EstatePropertyStructure {
  propertyId String              @map("property_id") @db.Uuid
  nodeId     String              @map("node_id") @db.Uuid
  property   EstateProperty      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  node       EstateStructureNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@id([propertyId, nodeId])
  @@index([nodeId])
  @@map("estate_property_structure")
}

model EstateResidentJoinRequest {
  id             String                         @id @default(uuid()) @db.Uuid
  estateId       String                         @map("estate_id") @db.Uuid
  propertyId     String?                        @map("property_id") @db.Uuid
  applicantId    String                         @map("applicant_id") @db.Uuid
  relationship   PropertyOccupancyRelationship?
  note           String?                        @db.VarChar(1000)
  status         ResidentJoinRequestStatus      @default(PENDING)
  submittedAt    DateTime                       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedById   String?                        @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?                      @map("reviewed_at") @db.Timestamptz(3)
  decisionReason String?                        @map("decision_reason") @db.VarChar(1000)
  createdAt      DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  estate         Estate                         @relation(fields: [estateId], references: [id], onDelete: Restrict)
  property       EstateProperty?                @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  applicant      User                           @relation("JoinRequestApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  reviewedBy     User?                          @relation("JoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([estateId, status, submittedAt])
  @@index([applicantId, submittedAt])
  @@map("estate_resident_join_requests")
}

model PropertyOccupancy {
  id                    String                        @id @default(uuid()) @db.Uuid
  estateId              String                        @map("estate_id") @db.Uuid
  propertyId            String                        @map("property_id") @db.Uuid
  residentId            String                        @map("resident_id") @db.Uuid
  relationship          PropertyOccupancyRelationship
  status                PropertyOccupancyStatus       @default(ACTIVE)
  effectiveFrom         DateTime                      @map("effective_from") @db.Date
  effectiveTo           DateTime?                     @map("effective_to") @db.Date
  approvedFromRequestId String?                       @unique @map("approved_from_request_id") @db.Uuid
  tenancyId             String?                       @unique @map("tenancy_id") @db.Uuid
  createdById           String                        @map("created_by_id") @db.Uuid
  endedById             String?                       @map("ended_by_id") @db.Uuid
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  estate                Estate                        @relation(fields: [estateId], references: [id], onDelete: Restrict)
  property              EstateProperty                @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  resident              User                          @relation("OccupancyResident", fields: [residentId], references: [id], onDelete: Restrict)
  createdBy             User                          @relation("OccupancyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  endedBy               User?                         @relation("OccupancyEnder", fields: [endedById], references: [id], onDelete: Restrict)
  tenancy               EstateTenancy?                @relation(fields: [tenancyId], references: [id], onDelete: Restrict)

  @@index([estateId, propertyId, status])
  @@index([residentId, status, effectiveFrom])
  @@map("property_occupancies")
}

model EstateTenancy {
  id                       String             @id @default(uuid()) @db.Uuid
  estateId                 String             @map("estate_id") @db.Uuid
  propertyId               String             @map("property_id") @db.Uuid
  tenantUserId             String             @map("tenant_user_id") @db.Uuid
